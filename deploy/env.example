# Copy to /etc/sip-ledger/env, chmod 0600, chown root:sip.
# Never commit the real file — .gitignore covers env and *.db already.

# Gmail app password (Google Account → Security → App passwords).
# Not the account password, and not an OAuth token.
IMAP_USER=rexlorenzo@gmail.com
IMAP_PASSWORD=xxxxxxxxxxxxxxxx
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX

# openssl rand -hex 32
SIP_TOKEN=

SIP_DB_PATH=/var/lib/sip-ledger/sip.db
SIP_ANCHOR_DATE=2026-07-12
SIP_HOST=127.0.0.1
SIP_PORT=8412

SIP_SENDER=panera@m2.panerabread.com

# Leave NTFY_TOPIC empty to disable push entirely.
# Use a long random topic name: ntfy.sh topics are public to anyone who guesses.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
